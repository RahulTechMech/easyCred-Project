# ==========================================================
# EasyCred — Environment Variables
# Copy this file to ".env.local" and fill in your own values.
# NEVER commit ".env.local" to git.
# ==========================================================

# --- MongoDB -------------------------------------------------
# 1. Go to https://www.mongodb.com/cloud/atlas/register and create a free account.
# 2. Create a free "M0" cluster (any cloud provider/region is fine).
# 3. Click "Database Access" -> "Add New Database User" -> create a username/password.
# 4. Click "Network Access" -> "Add IP Address" -> "Allow Access From Anywhere" (0.0.0.0/0)
#    for local dev. Restrict this to your server's IP once you deploy to production.
# 5. Click "Connect" -> "Drivers" -> copy the connection string and paste it below,
#    replacing <username>, <password> and adding a database name (e.g. "easycred").
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/easycred?retryWrites=true&w=majority

# --- App -------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Excel export ------------------------------------------------
# Local folder (relative to project root) where the auto-updated
# leads spreadsheet is written. Created automatically if missing.
EXCEL_EXPORT_DIR=data/exports
EXCEL_EXPORT_FILENAME=easycred-leads.xlsx

# --- Admin CRM login (simple env-based auth for now) --------------
# The email/password used to log in at /admin/login. Replace this with
# NextAuth/Auth.js or a full identity provider later — see lib/auth/adminAuth.ts.
ADMIN_EMAIL=admin@easycred.example
ADMIN_PASSWORD=change-this-to-a-strong-password

# Long random string used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# --- Admin API key (used to protect the Excel download endpoint) --
ADMIN_API_KEY=change-this-to-a-long-random-string

# --- Email (optional, used by /lib/email — fill in when you wire up Nodemailer) --
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM="EasyCred <no-reply@easycred.example>"
ADMIN_NOTIFY_EMAIL=leads@easycred.example
